{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisper Dictate",
  "version": "0.3.0",
  "identifier": "com.vladislav.whisperdictate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Whisper Dictate",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "© 2026 Vladislav Tupikin",
    "shortDescription": "Local speech-to-text via Whisper",
    "longDescription": "Whisper Dictate — fully local speech recognition via Whisper, no audio leaves the device. Transcript can be edited and copied.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQjU1NDA2N0E3RTlGMzkKUldRNW4zNTZCbFMxd0JpQkpwd3E3bUJob2dpVGlCRklpTUhaTW4xWmhaZlQrZ3cvL2tuOGlneGMK",
      "endpoints": [
        "https://github.com/MrRefactoring/whisper-dictate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
